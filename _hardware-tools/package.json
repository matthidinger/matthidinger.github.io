    "glb": "node compress-glb.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "esbuild": "0.25.10",
    "meshoptimizer": "1.2.0",
    "sharp": "0.35.5",
    "three": "0.186.1"
  }
}

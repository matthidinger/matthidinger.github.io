{
  "productionOrigins": [
    "https://matthidinger.com",
    "http://matthidinger.com",
    "https://www.matthidinger.com",
    "http://www.matthidinger.com"
  ],
  "build": {
    "productionShape": {
      "talks/index.html": [
        "<link rel=\"canonical\" href=\"https://matthidinger.com/talks/\"",
        "href=\"https://matthidinger.com/assets/css/dusk-page.css\""
      ],
      "CNAME": [
        "matthidinger.com"
      ],
      "Default.aspx/index.html": [
        "<link rel=\"canonical\" href=\"https://matthidinger.com/\">",
        "url=https://matthidinger.com/\""
      ]
    },
    "mustNotExist": [
      "home",
      "AGENTS.md",
      ".github",
      ".artifacts",
      "_config.yml",
      "Gemfile",
      "Gemfile.lock",
      "package.json",
      "node_modules"
    ]
  },
  "viewports": [
    {
      "name": "desktop",
      "width": 1280,
      "height": 900
    },
    {
      "name": "mobile",
      "width": 390,
      "height": 844,
      "isMobile": true
    }
  ],
  "routes": [
    {
      "id": "home",
      "path": "/",
      "purpose": "Home page (Dusk layout): scroll-driven sunset scene, About, Work with the original logos, latest posts",
      "title": "Matt Hidinger",
      "text": [
        "Principal Product Manager at Microsoft in Seattle. Into Sailing and making.",
        "Microsoft",
        "Clarity Consulting",
        "Triton-Tek",
        "Parent's basement",
        "199X"
      ],
      "absentText": [
        "Principal Program Manager",
        "Facebook"
      ],
      "selectors": {
        ".dk-nav a": 3,
        ".dk-about img": 1,
        ".dk-work img.dk-badge": 4,
        ".dk-posts a": 5,
        ".dk-more a": 1,
        ".dk-foot a": 6
      },
      "maxSelectors": {
        ".masthead": 0,
        ".dk-sig": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        "img[loading=\"lazy\"]": 0,
        ".code-copy": 0
      },
      "interactions": [
        {
          "name": "home nav to About",
          "click": ".dk-nav a[href$=\"/about/\"]",
          "expectPath": "/about/"
        },
        {
          "name": "home nav to Blog",
          "click": ".dk-nav a[href$=\"/blog/\"]",
          "expectPath": "/blog/"
        },
        {
          "name": "home nav to Talks",
          "click": ".dk-nav a[href$=\"/talks/\"]",
          "expectPath": "/talks/"
        },
        {
          "name": "home latest post",
          "click": ".dk-posts li:first-child a",
          "expectPath": "/archive/2013/07/02/video-and-code-from-my-build-talk-on-sharing-code/"
        },
        {
          "name": "home view more posts",
          "click": ".dk-more a",
          "expectPath": "/blog/"
        },
        {
          "name": "home footer to Talks",
          "click": ".dk-foot a[href$=\"/talks/\"]",
          "expectPath": "/talks/"
        }
      ]
    },
    {
      "id": "about",
      "path": "/about/",
      "purpose": "About page in the shared Dusk shell (masthead, night footer); round trips to home and the blog",
      "title": "About",
      "h1": "About",
      "text": [
        "Principal Product Manager at Microsoft"
      ],
      "absentText": [
        "Principal Program Manager",
        "Facebook"
      ],
      "selectors": {
        ".dk-sig": 1,
        ".dk-nav a": 3,
        ".dkp-mast-art": 1,
        ".dk-foot-scene": 1
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".code-copy": 0
      },
      "interactions": [
        {
          "name": "about back to home",
          "click": ".dk-sig",
          "expectPath": "/"
        },
        {
          "name": "about nav to Blog",
          "click": ".dk-nav a[href$=\"/blog/\"]",
          "expectPath": "/blog/"
        }
      ]
    },
    {
      "id": "blog",
      "path": "/blog/",
      "purpose": "Blog listing (paginated archive) as a Dusk reading index",
      "title": "Blog",
      "h1": "Blog",
      "selectors": {
        ".archive__item-title": 5,
        ".archive__item .page__meta-item time": 5,
        "nav.pagination a[rel=\"next\"]": 1,
        "nav.pagination a[aria-current=\"page\"]": 1,
        ".dkp-mast-art": 1,
        ".dk-foot-scene": 1
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        "nav.pagination a[rel=\"prev\"]": 0,
        ".code-copy": 0
      },
      "absentText": [
        "Facebook"
      ],
      "interactions": [
        {
          "name": "blog next page",
          "click": "nav.pagination a[rel=\"next\"]",
          "expectPath": "/blog/page2/"
        },
        {
          "name": "blog back to home",
          "click": ".dk-sig",
          "expectPath": "/"
        },
        {
          "name": "blog nav to Talks",
          "click": ".dk-nav a[href$=\"/talks/\"]",
          "expectPath": "/talks/"
        },
        {
          "name": "blog topics",
          "click": ".dkp-head a[href$=\"/tags/\"]",
          "expectPath": "/tags/"
        }
      ]
    },
    {
      "id": "talks",
      "path": "/talks/",
      "purpose": "Talks marquee (#11): featured recordings that open in a theater, what's coming up, then every talk by year",
      "title": "Talks",
      "h1": "Talks",
      "text": [
        "All talks",
        "Adaptive Cards vNext",
        "Unlock Productivity with AI in Power Apps",
        "Community calls and podcasts"
      ],
      "minText": 50,
      "selectors": {
        ".dk-sig": 1,
        ".dkp-mast-art": 1,
        ".tkc-hero img": 1,
        ".tkc-poster": 3,
        ".tkl-rows > li": 20,
        ".tkl-links a.is-watch": 10,
        ".dk-foot-scene": 1
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".code-copy": 0
      },
      "absentText": [
        "Facebook",
        "These are talks I"
      ],
      "interactions": [
        {
          "name": "talks poster opens theater",
          "click": ".tkc-poster[data-play]",
          "expectVisible": ".tkc-theater"
        },
        {
          "name": "talks back to home",
          "click": ".dk-sig",
          "expectPath": "/"
        },
        {
          "name": "talks nav to About",
          "click": ".dk-nav a[href$=\"/about/\"]",
          "expectPath": "/about/"
        }
      ]
    },
    {
      "id": "tags",
      "path": "/tags/",
      "purpose": "Blog topics: every post grouped by tag in the Dusk reading shell",
      "title": "Blog topics",
      "h1": "Blog topics",
      "selectors": {
        ".dkp-mast-art": 1,
        ".dk-foot-scene": 1
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".code-copy": 0
      },
      "absentText": [
        "Facebook"
      ],
      "interactions": [
        {
          "name": "topics back to the blog",
          "click": ".dkp-head a[href$=\"/blog/\"]",
          "expectPath": "/blog/"
        }
      ]
    },
    {
      "id": "post-code",
      "path": "/archive/2008/05/08/linq-to-sql-audit-trail/",
      "purpose": "Post with many fenced C# code blocks and images in the Dusk reading layout",
      "title": "LINQ to SQL Audit Trail",
      "h1": "LINQ to SQL Audit Trail",
      "selectors": {
        "pre.highlight": 10,
        ".page__content img": 5,
        "header .page__meta time": 1,
        ".dk-sig": 1,
        ".dkp-mast-art": 1,
        ".dk-foot-scene": 1
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".page__content h1": 0,
        ".page__content h2:empty, .page__content h3:empty, .page__content h4:empty": 0
      },
      "interactions": [
        {
          "name": "next post",
          "click": ".post-pager__link--next",
          "expectPath": "/archive/2008/06/17/synergy-3-desktops-1-keyboard/"
        },
        {
          "name": "post back to home",
          "click": ".dk-sig",
          "expectPath": "/"
        }
      ],
      "copyCode": {
        "min": 13
      },
      "absentText": [
        "Facebook"
      ]
    },
    {
      "id": "post-migrated-code",
      "path": "/archive/2009/01/12/linq-audit-trail-v2/",
      "purpose": "Migrated post with list-indented and plain code fences",
      "title": "LINQ Audit Trail v2",
      "h1": "LINQ Audit Trail v2 - DoddleAudit",
      "selectors": {
        "pre.highlight": 3,
        "li pre.highlight": 1
      },
      "absentText": [
        "### Usage",
        "**Doddle",
        "Facebook"
      ],
      "text": [
        "Usage"
      ],
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".page__content h1": 0,
        ".page__content h2:empty, .page__content h3:empty, .page__content h4:empty": 0
      },
      "copyCode": {
        "min": 3
      }
    },
    {
      "id": "post-table-images",
      "path": "/archive/2012/12/05/sharing-code-windows-8-and-windows-phone/",
      "purpose": "Migrated post whose layout tables became images/paragraphs; code, images and a former setext heading",
      "title": "Sharing Code: Windows 8 and Windows Phone",
      "h1": "Sharing Code: Windows 8 and Windows Phone",
      "selectors": {
        ".page__content img": 6,
        "pre.highlight": 2,
        ".page__content h3#finally-above-all-else": 1
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".page__content h1": 0,
        ".page__content h2:empty, .page__content h3:empty, .page__content h4:empty": 0,
        ".page__content table:not(.layout-grid)": 0
      },
      "absentText": [
        "**",
        "###",
        "Facebook"
      ],
      "copyCode": {
        "min": 3
      }
    },
    {
      "id": "blog-page-2",
      "path": "/blog/page2/",
      "purpose": "Blog listing page 2: paginator links back to /blog/ (not the home timeline) and on to page 3",
      "title": "Blog - Matt Hidinger - Page 2",
      "h1": "Blog",
      "selectors": {
        ".archive__item-title": 5,
        "nav.pagination a[aria-current=\"page\"]": 1
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".code-copy": 0
      },
      "interactions": [
        {
          "name": "paginator previous",
          "click": "nav.pagination a[rel=\"prev\"]",
          "expectPath": "/blog/"
        },
        {
          "name": "paginator next",
          "click": "nav.pagination a[rel=\"next\"]",
          "expectPath": "/blog/page3/"
        }
      ],
      "absentText": [
        "Facebook"
      ]
    },
    {
      "id": "post-layout-grid",
      "path": "/archive/2011/12/07/Transform-your-LINQ-queries-into-ExcelPDF-reports-with-DoddleReport-1/",
      "purpose": "Migrated two-column HTML layout table rendered as a responsive grid; dead CodePlex thumbnails replaced with the archived local copies",
      "title": "Transform your LINQ queries into Excel/PDF reports with DoddleReport 1.2",
      "h1": "Transform your LINQ queries into Excel/PDF reports with DoddleReport 1.2",
      "selectors": {
        "table.layout-grid": 1,
        "table.layout-grid img": 6,
        ".page__content img": 7
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".page__content h1": 0,
        ".page__content h2:empty, .page__content h3:empty, .page__content h4:empty": 0,
        ".code-copy": 0
      },
      "absentText": [
        "**",
        "Facebook"
      ]
    },
    {
      "id": "post-image-layout",
      "path": "/archive/2010/03/25/share-your-resharper-templates-across-all-your-dev-machines/",
      "purpose": "Former Markdown layout table converted to floated screenshots with captions in prose",
      "title": "Share your ReSharper templates across all your dev machines",
      "h1": "Share your ReSharper templates across all your dev machines",
      "selectors": {
        ".page__content img": 4
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".page__content h1": 0,
        ".page__content h2:empty, .page__content h3:empty, .page__content h4:empty": 0,
        ".page__content table": 0,
        ".code-copy": 0
      },
      "absentText": [
        "| ---",
        "Facebook"
      ]
    },
    {
      "id": "post-series",
      "path": "/archive/2011/10/16/RealWorldWPDev-Part-3-Caliburn-Micro-and-Application-Infrastructure/",
      "purpose": "Series post: setext series links are links (not h1), code fences have correct languages, numbered steps continue after a code block",
      "title": "RealWorldWPDev Part 3: Caliburn.Micro and Application Infrastructure",
      "h1": "RealWorldWPDev Part 3: Caliburn.Micro and Application Infrastructure",
      "selectors": {
        "p.series-link a": 2,
        "div.language-csharp pre.highlight": 2,
        "div.language-xml pre.highlight": 2,
        ".page__content ol[start=\"8\"]": 1
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".page__content h1": 0,
        ".page__content h2:empty, .page__content h3:empty, .page__content h4:empty": 0,
        "div.language-plaintext pre.highlight": 0
      },
      "interactions": [
        {
          "name": "previous post (decoded title)",
          "click": ".post-pager__link--prev",
          "expectPath": "/archive/2011/10/16/RealWorldWPDev-Part-2-File-ndashgt-New-Project/"
        }
      ],
      "copyCode": {
        "min": 4
      },
      "absentText": [
        "Facebook"
      ]
    },
    {
      "id": "post-inline-code",
      "path": "/archive/2011/12/12/tweaking-subtext-with-hero-shots-next-to-each-post/",
      "purpose": "Post mixing inline code in a numbered list with code blocks: copy buttons on blocks only, never on inline code",
      "title": "Tweaking Subtext with Hero Shots next to each post",
      "h1": "Tweaking Subtext with Hero Shots next to each post",
      "text": [
        "If no images have that ID"
      ],
      "selectors": {
        "pre.highlight": 3,
        ".page__content li > code": 3
      },
      "maxSelectors": {
        ".masthead": 0,
        "link[href$=\"/assets/css/main.css\"]": 0,
        "a[href*=\"facebook.com\"], a[href*=\"plus.google.com\"]": 0,
        ".page__content :not(pre) > code ~ .code-copy, .page__content li > .code-copy, .page__content p > .code-copy": 0
      },
      "copyCode": {
        "min": 3
      },
      "absentText": [
        "Facebook"
      ]
    }
  ]
}
